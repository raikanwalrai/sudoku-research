# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Build artifacts
build/
dist/
*.egg-info/

# Experiment outputs
experiments/*/checkpoints/
experiments/*/runs/
experiments/*/tensorboard/

# Large generated artifacts
models/**/*.pt
models/**/*.pth
models/**/*.ckpt

# Local data that should not be committed by default
data/raw/*
data/processed/*
data/train/*
data/validation/*
data/test/*

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/train/.gitkeep
!data/validation/.gitkeep
!data/test/.gitkeep

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
credential.json
service-account.json
secrets.json
secret.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary files
*.tmp
*.swp
*.bak
